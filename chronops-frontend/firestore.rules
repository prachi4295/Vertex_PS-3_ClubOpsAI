rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the parent event
    function isEventOwner(eventId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Tasks collection: top-level collection carrying eventId
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isEventOwner(request.resource.data.eventId);
      allow update, delete: if isAuthenticated() && isEventOwner(resource.data.eventId);
    }

    // Sessions collection: top-level collection carrying eventId
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isEventOwner(request.resource.data.eventId);
      allow update, delete: if isAuthenticated() && isEventOwner(resource.data.eventId);
    }
  }
}
